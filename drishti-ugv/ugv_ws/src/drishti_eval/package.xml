<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drishti_eval</name>
  <version>0.1.0</version>
  <description>
    Evaluation harness: localisation error (ATE, RPE, drift), emergency-stop
    latency, and fault injection for the T16-T19 failure scenarios.

    Only bag_reader and fault_injector_node import ROS. The metrics, the
    latency measurement and the fault schedules are plain Python and are tested
    without an install.
  </description>

  <!-- TODO: replace with a real team contact before the repository is shared. -->
  <maintainer email="team@thevikings.example">The Vikings</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
