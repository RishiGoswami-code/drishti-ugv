<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drishti_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and the single shared parameter file for the DRISHTI-UGV
    stack. Holds no algorithm code: this package exists so that every node
    reads its thresholds and its clock setting from one place.
  </description>

  <!-- TODO: replace with a real team contact before the repository is shared. -->
  <maintainer email="team@thevikings.example">The Vikings</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>drishti_msgs</exec_depend>
  <exec_depend>drishti_safety</exec_depend>
  <exec_depend>drishti_sim</exec_depend>
  <exec_depend>drishti_sim_isaac</exec_depend>
  <exec_depend>drishti_description</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
