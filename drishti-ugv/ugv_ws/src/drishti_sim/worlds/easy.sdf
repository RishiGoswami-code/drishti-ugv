<?xml version="1.0" ?>
<!--
  EVALUATION.md world "Easy": flat compacted dirt, sparse rocks, clean midday
  light. Scenarios T01 and T02.

  This is the baseline that must work before anything harder is attempted. If
  the UGV cannot cross this world, no amount of perception will save the
  stack, which is the whole point of the Phase 1 gate.

  Deliberately absent: slopes, ditches, mud, vegetation, moving obstacles,
  adversarial lighting. Those belong to the Medium, Hard, Dynamic and
  Adversarial worlds and must not leak backwards into the baseline.

  !! UNVERIFIED !! Never loaded by Gazebo. XML structure is checked by
  tools/check_sim_assets.py; physics and rendering are not.
-->
<sdf version="1.9">
  <world name="easy">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Required for the camera and depth sensors to produce anything. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.565e-6 2.289e-5 -4.239e-5</magnetic_field>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Midday sun, high elevation, soft shadows. Adversarial lighting is a
         different world; do not tune this one to be difficult. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.25 -0.9</direction>
    </light>

    <!-- ================================================== ground ==== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material>
            <ambient>0.42 0.34 0.24 1</ambient>
            <diffuse>0.52 0.42 0.30 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================ sparse rocks ==== -->
    <!--
      T02: obstacle detection on an otherwise trivial world. Placed off the
      straight line from spawn (0,0) to the Phase 1 goal (8,0) so that the
      baseline goal test does not silently become an avoidance test. Nav2
      should route between them without drama.
    -->
    <model name="rock_a">
      <static>true</static>
      <pose>3.2 1.5 0.18 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.36</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.36</radius></sphere></geometry>
          <material>
            <ambient>0.28 0.27 0.26 1</ambient>
            <diffuse>0.38 0.37 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_b">
      <static>true</static>
      <pose>5.6 -1.9 0.14 0 0 1.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.28</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.28</radius></sphere></geometry>
          <material>
            <ambient>0.30 0.28 0.26 1</ambient>
            <diffuse>0.40 0.38 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_c">
      <static>true</static>
      <pose>7.4 2.6 0.22 0 0 2.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.42 0.44</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.42 0.44</size></box></geometry>
          <material>
            <ambient>0.26 0.25 0.24 1</ambient>
            <diffuse>0.36 0.35 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Texture for visual odometry. A featureless plane is a SLAM torture test
      (scenario T15) and would make Phase 2 fail for the wrong reason, so the
      baseline world gets a few low, harmless markers to track. They are 2 cm
      tall and outside the driving corridor.
    -->
    <model name="texture_patch_left">
      <static>true</static>
      <pose>4.0 4.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.0 3.0 0.02</size></box></geometry>
          <material>
            <ambient>0.34 0.30 0.22 1</ambient>
            <diffuse>0.46 0.40 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>6.0 3.0 0.02</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="texture_patch_right">
      <static>true</static>
      <pose>4.5 -4.8 0.01 0 0 0.3</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.0 2.4 0.02</size></box></geometry>
          <material>
            <ambient>0.36 0.31 0.23 1</ambient>
            <diffuse>0.48 0.42 0.30 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>5.0 2.4 0.02</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
